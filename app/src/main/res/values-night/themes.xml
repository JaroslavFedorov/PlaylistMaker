<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Базовая тема с поддержкой ночного режима -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Цвет фона -->
        <item name="colorBackground">@color/colorBackground</item> <!-- #1A1B22 -->

        <!-- Основные цвета -->
        <item name="colorPrimary">@color/main_background</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Цвета кнопок -->
        <item name="colorButtonBackground">@color/button_background</item>
        <item name="colorButtonText">@color/button_text</item>

        <!-- Цвета для экрана настроек -->
        <item name="colorSettingsBackground">@color/settings_background_dark</item>
        <item name="colorSettingsText">@color/settings_text_dark</item>

        <!-- Цвет иконок в настройках -->
        <item name="colorSettingsIcon">@color/colorSettingsIcon</item>

        <!-- Атрибуты для поля поиска -->
        <item name="colorSearchInputText">@color/search_input_text</item>
        <item name="colorSearchHintText">@color/search_hint_text</item>
        <item name="colorSearchIconTint">@color/search_icon_tint</item>
        <item name="colorNavigationIcon">@color/white</item>

        <!-- Стилизация Toolbar -->
        <item name="toolbarStyle">@style/Widget.PlaylistMaker.Toolbar</item>
    </style>

    <!-- Основная тема -->
    <style name="Theme.PlaylistMaker" parent="Base.Theme.PlaylistMaker" />

    <!-- Стиль для Toolbar -->
    <style name="Widget.PlaylistMaker.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:layout_height">56dp</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="android:background">@color/colorBackground</item>
        <item name="navigationIconTint">?attr/colorNavigationIcon</item>
    </style>

</resources>
