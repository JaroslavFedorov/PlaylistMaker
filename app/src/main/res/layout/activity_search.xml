<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSettingsBackground">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSettingsBackground"
        app:title="@string/search"
        app:titleTextColor="?attr/colorSettingsText"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Поле поиска с кнопкой очистки -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Поиск"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:autofillHints="search"
            android:background="@drawable/search_edit_background"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:textColor="?attr/colorSettingsText"
            android:textColorHint="#7F7F7F"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="#7F7F7F"
            android:drawablePadding="12dp" />

        <ImageView
            android:id="@+id/clear_search_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_clear"
            android:visibility="gone"
            android:contentDescription="@string/clear_icon_desc"
            app:tint="?attr/colorSettingsText" />
    </FrameLayout>

</LinearLayout>
