<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSettingsBackground"
    tools:context=".SettingsActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSettingsBackground"
        android:elevation="0dp"
        app:elevation="0dp"
        app:title="@string/settings_title"
        app:titleTextColor="?attr/colorSettingsText"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:contentInsetStartWithNavigation="16dp"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Первый пункт: Темная тема -->
    <LinearLayout
        android:id="@+id/dark_theme_item"
        style="@style/SettingsMenuItemNonClickable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        android:paddingTop="21dp"
        android:paddingBottom="21dp">

        <TextView
            style="@style/SettingsMenuItemText"
            android:text="@string/dark_theme"
            android:textColor="?attr/colorSettingsText"
            android:labelFor="@id/switch_dark_theme" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_dark_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />
    </LinearLayout>

    <!-- Пункт "Поделиться приложением" -->
    <LinearLayout
        android:id="@+id/share_item"
        style="@style/SettingsMenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="21dp"
        android:paddingBottom="21dp">

        <TextView
            style="@style/SettingsMenuItemText"
            android:text="@string/share_app"
            android:textColor="?attr/colorSettingsText" />

        <ImageView
            style="@style/SettingsMenuItemIcon"
            android:contentDescription="@string/share_icon_desc"
            android:src="@drawable/ic_share"
            app:tint="?attr/colorSettingsIcon" />
    </LinearLayout>

    <!-- Пункт "Написать в поддержку" -->
    <LinearLayout
        android:id="@+id/support_item"
        style="@style/SettingsMenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="21dp"
        android:paddingBottom="21dp">

        <TextView
            style="@style/SettingsMenuItemText"
            android:text="@string/support"
            android:textColor="?attr/colorSettingsText" />

        <ImageView
            style="@style/SettingsMenuItemIcon"
            android:contentDescription="@string/support_icon_desc"
            android:src="@drawable/ic_support"
            app:tint="?attr/colorSettingsIcon" />
    </LinearLayout>

    <!-- Пункт "Лицензионное соглашение" -->
    <LinearLayout
        android:id="@+id/agreement_item"
        style="@style/SettingsMenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="21dp"
        android:paddingBottom="21dp">

        <TextView
            style="@style/SettingsMenuItemText"
            android:text="@string/agreement"
            android:textColor="?attr/colorSettingsText" />

        <ImageView
            style="@style/SettingsMenuItemIcon"
            android:contentDescription="@string/agreement_icon_desc"
            android:src="@drawable/ic_arrow_right"
            app:tint="?attr/colorSettingsIcon" />
    </LinearLayout>

</LinearLayout>

